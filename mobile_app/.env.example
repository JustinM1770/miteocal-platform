# Copia este archivo como .env (no se sube al repo) y corre:
#
#   flutter run --dart-define-from-file=.env
#
# MAPBOX_TOKEN: token PUBLICO de Mapbox (pk.…), el mismo que usa el panel
# (NEXT_PUBLIC_MAPBOX_TOKEN). Sin el, los mapas muestran la ilustracion.
MAPBOX_TOKEN=
# FUENTE=firebase usa el proyecto real; sin ella, datos de demo.
FUENTE=demo
