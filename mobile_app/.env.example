# La app Flutter recibe estos valores con --dart-define, no leyendo un archivo.
# Este archivo documenta cuales son y sirve de referencia para el equipo.
#
#   flutter run --dart-define=USAR_EMULADORES=true \
#               --dart-define=GOOGLE_MAPS_API_KEY=...
#
# firebase_options.dart, google-services.json y GoogleService-Info.plist los
# genera `flutterfire configure` y NO se versionan.

GOOGLE_MAPS_API_KEY=
USAR_EMULADORES=true
