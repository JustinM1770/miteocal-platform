# Copia este archivo a .env. Vite solo expone las variables con prefijo VITE_.
# Ojo: estas claves viajan al navegador. No son secretas — la seguridad real
# la imponen las reglas de Firestore, no el ocultar estos valores.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=miteocal-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=miteocal-dev
VITE_FIREBASE_STORAGE_BUCKET=miteocal-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_GOOGLE_MAPS_API_KEY=

# En 1, el panel se conecta a los emuladores locales en vez de a produccion.
VITE_USAR_EMULADORES=1
