# Firebase · configuración de la app web
# Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK
# Sin estas variables el panel corre en MODO DEMO con un municipio de ejemplo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo servidor: credenciales de cuenta de servicio para las rutas API.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ANTHROPIC_API_KEY=

# Mapbox (token público pk.…). Restríngelo a los dominios del panel en tu cuenta de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcionales
# El municipio NO se configura aquí: sale del custom claim `municipioId` de cada cuenta.
# Centro del mapa si las colonias aún no tienen coordenadas ("lng,lat"):
NEXT_PUBLIC_MUNICIPIO_CENTRO=
# Subtítulo de la pantalla de inicio de sesión:
NEXT_PUBLIC_PANEL_SUBTITULO=
