# ==========================================================
# MiTeocal Platform — .gitignore
# Stack: Flutter (mobile_app) · Node.js (backend) · React/Vite (admin_panel) · Firebase
# ==========================================================

# ----------------------------------------------------------
# 1. SECRETOS Y CREDENCIALES  (nunca subir al repositorio)
# ----------------------------------------------------------
# Variables de entorno
.env
.env.*
!.env.example
!.env.template
*.env

# Llaves de servicio de Firebase / Google Cloud
serviceAccount*.json
service-account*.json
*serviceAccountKey*.json
*-firebase-adminsdk-*.json
*firebase-adminsdk*.json
firebase-key.json
gcloud-key.json
google-credentials.json
application_default_credentials.json

# Configuración generada por FlutterFire / SDKs de Firebase
google-services.json
GoogleService-Info.plist
firebase_options.dart
firebase-config.js
firebase-config.ts

# Cualquier JSON dentro de carpetas de secretos
**/secrets/
**/credentials/
**/keys/
**/*.secret.json
**/*.private.json

# Certificados y llaves criptográficas
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.der
*.keystore
*.jks
key.properties

# Excepciones: archivos de configuración públicos que SÍ se versionan
!package.json
!package-lock.json
!tsconfig.json
!firebase.json
!.firebaserc
!firestore.indexes.json
!database.rules.json
!eslintrc.json
!.eslintrc.json
!composer.json
!analysis_options.yaml

