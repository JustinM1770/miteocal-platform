# Copia este archivo a .env y completa los valores. NUNCA subas el .env.
#
# Para trabajar contra el emulador NO necesitas credenciales reales:
#   npm run emu    (usa el proyecto demo y no toca datos de produccion)

FIREBASE_PROJECT_ID=miteocal-dev

# Cuenta de servicio del Admin SDK. Solo para desplegar o sembrar en la nube.
# Se descarga de: Consola de Firebase > Configuracion > Cuentas de servicio.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Apunta el Admin SDK a los emuladores locales.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
